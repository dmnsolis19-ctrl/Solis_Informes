{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solis-informes",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "solis-field",
      "database_id": "REEMPLAZAR_CON_ID_D1",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "solis-field-files"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "browser": {
    "binding": "BROWSER"
  },
  // Opcionales (3.6): APP_URL, TIMEZONE, DIGEST_ENABLED, BACKUP_KEEP_DAYS. Secreto recomendado: APP_SECRET.
  // Enlace R2 opcional para respaldos: { "binding": "BACKUP_BUCKET", "bucket_name": "solis-field-backups" } dentro de r2_buckets.
  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_DAILY_LIMIT": "30",
    "APP_NAME": "SOLIS Field"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "0 11 * * *"
    ]
  }
}
